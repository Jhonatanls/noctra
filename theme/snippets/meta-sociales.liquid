{%- comment -%} Metadatos para compartir en redes y WhatsApp (RNF-14). {%- endcomment -%}
{%- liquid
  assign og_titulo = page_title | default: shop.name
  assign og_descripcion = page_description | default: shop.description
  assign og_tipo = 'website'
  if request.page_type == 'product'
    assign og_tipo = 'product'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_titulo | escape }}">
<meta property="og:type" content="{{ og_tipo }}">
{%- if og_descripcion != blank -%}
  <meta property="og:description" content="{{ og_descripcion | escape }}">
{%- endif -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
