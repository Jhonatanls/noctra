{{ 'componente-carrito.css' | asset_url | stylesheet_tag }}
{{ 'componente-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'componente-combos.js' | asset_url }}" type="module"></script>

{%- liquid
  assign numero_whatsapp = settings.whatsapp_numero | remove: '+' | remove: ' ' | remove: '-'
  assign umbral_envio = settings.envio_gratis_desde | times: 100
  assign falta_envio = umbral_envio | minus: cart.total_price
  if umbral_envio > 0
    assign progreso = cart.total_price | times: 100 | divided_by: umbral_envio
    if progreso > 100
      assign progreso = 100
    endif
  endif
-%}

<carrito-combos class="carrito-combos" data-seccion="{{ section.id }}" data-url="{{ routes.cart_url }}" data-agregar="{{ routes.cart_add_url }}.js">
<section class="seccion carrito">
  <div class="contenedor">
    <h1 tabindex="-1" data-foco>Tu carrito</h1>
    <p class="oculto-visual" role="status" aria-live="polite" data-anuncio-combos></p>

    <div data-reemplazable>
    {%- if cart.item_count > 0 -%}
      {% render 'combos-mensajes', contexto: 'carrito' %}
      {% render 'combos-regalo' %}

      {%- if umbral_envio > 0 -%}
        <div class="carrito__envio">
          {%- if falta_envio > 0 -%}
            <p>Te faltan <strong class="precio">{{ falta_envio | money }}</strong> para el envío gratis.</p>
          {%- else -%}
            <p>Tu pedido tiene envío gratis.</p>
          {%- endif -%}
          {%- if shop.shipping_policy -%}
            <p class="nota-legal"><a href="{{ shop.shipping_policy.url }}">Consulta las condiciones de envío</a></p>
          {%- endif -%}
          <div class="carrito__barra" role="progressbar" aria-label="Progreso al envío gratis" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progreso }}">
            <span class="carrito__barra-relleno" style="inline-size: {{ progreso }}%"></span>
          </div>
        </div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post" class="carrito__formulario">
        <ul class="carrito__lineas">
          {%- for item in cart.items -%}
            <li class="carrito__linea">
              <a href="{{ item.url }}" class="carrito__foto">
                {%- if item.image != blank -%}
                  {%- assign alt_item = item.image.alt | default: item.product.title -%}
                  {{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '120px', loading: 'lazy', alt: alt_item }}
                {%- endif -%}
              </a>
              <div class="carrito__datos">
                <a href="{{ item.url }}" class="carrito__nombre">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="carrito__variante">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for asignacion in item.line_level_discount_allocations -%}
                  {%- if asignacion.amount == 0 -%}{%- continue -%}{%- endif -%}
                  <p class="carrito__descuento">{{ asignacion.discount_application.title }}: &minus;{{ asignacion.amount | money }}</p>
                {%- endfor -%}
                {%- liquid
                  # Unidades de esta misma referencia en otras líneas (Shopify divide una línea cuando un combo aplica a parte de ella)
                  assign en_carrito = 0
                  for otra in cart.items
                    if otra.variant_id == item.variant_id
                      assign en_carrito = en_carrito | plus: otra.quantity
                    endif
                  endfor
                  assign limitado = false
                  if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
                    assign limitado = true
                    assign maximo_linea = item.variant.inventory_quantity | minus: en_carrito | plus: item.quantity
                    if maximo_linea < item.quantity
                      assign maximo_linea = item.quantity
                    endif
                  endif
                -%}
                <div class="cantidad carrito__cantidad">
                  <button type="button" class="cantidad__boton" data-paso="-1" data-variante="{{ item.variant_id }}" aria-label="{{ 'carrito.restar' | t: producto: item.product.title }}">
                    <span aria-hidden="true">&minus;</span>
                  </button>
                  <label class="oculto-visual" for="cantidad-{{ section.id }}-{{ forloop.index }}">{{ 'carrito.cantidad' | t: producto: item.product.title }}</label>
                  <input
                    id="cantidad-{{ section.id }}-{{ forloop.index }}"
                    class="cantidad__campo"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    {% if limitado %}max="{{ maximo_linea }}"{% endif %}
                    inputmode="numeric"
                    data-clave="{{ item.key }}"
                    data-variante="{{ item.variant_id }}"
                  >
                  <button type="button" class="cantidad__boton" data-paso="1" data-variante="{{ item.variant_id }}" aria-label="{{ 'carrito.sumar' | t: producto: item.product.title }}"{% if limitado and item.quantity >= maximo_linea %} aria-disabled="true"{% endif %}>
                    <span aria-hidden="true">+</span>
                  </button>
                </div>
                {%- if limitado and item.quantity >= maximo_linea -%}
                  <p class="carrito__aviso-stock">{{ 'carrito.ultimas' | t }}</p>
                {%- endif -%}
                <a class="carrito__quitar" href="{{ item.url_to_remove }}">Quitar</a>
              </div>
              <p class="carrito__precio">
                {%- if item.original_line_price > item.final_line_price -%}
                  <s class="precio__anterior">{{ item.original_line_price | money }}</s>
                {%- endif -%}
                <span class="precio">{{ item.final_line_price | money }}</span>
              </p>
            </li>
          {%- endfor -%}
        </ul>

        <div class="carrito__resumen">
          {%- for descuento in cart.cart_level_discount_applications -%}
            <p class="carrito__descuento">{{ descuento.title }}: &minus;{{ descuento.total_allocated_amount | money }}</p>
          {%- endfor -%}
          {%- if cart.total_discount > 0 -%}
            <p class="carrito__ahorro">Ahorras <span class="precio">{{ cart.total_discount | money }}</span></p>
          {%- endif -%}
          <p class="carrito__total">Total <span class="precio" data-total>{{ cart.total_price | money }}</span></p>
          <p class="carrito__nota">{% if cart.taxes_included %}IVA incluido. {% endif %}El envío se calcula al finalizar la compra.</p>

          <button type="submit" name="update" class="boton boton--secundario carrito__actualizar">Actualizar cantidades</button>
          <button type="submit" name="checkout" class="boton boton--ancho">Finalizar compra</button>

          {%- if numero_whatsapp != blank -%}
            {%- capture linea_combo -%}{%- render 'combos-linea-whatsapp' -%}{%- endcapture -%}
            {%- assign linea_combo = linea_combo | strip -%}
            {%- capture mensaje_wa -%}
Hola, quiero hacer este pedido:
{% for item in cart.items %}• {{ item.product.title }}{% unless item.product.has_only_default_variant %}, {{ item.variant.title }}{% endunless %} × {{ item.quantity }} — {{ item.final_line_price | money_without_trailing_zeros | strip_html }}
{% endfor %}{% if linea_combo != blank %}{{ linea_combo }}
{% endif %}{% if cart.total_discount > 0 %}Ahorro aplicado: {{ cart.total_discount | money_without_trailing_zeros | strip_html }}
{% endif %}Total estimado: {{ cart.total_price | money_without_trailing_zeros | strip_html }}
¿Me confirman disponibilidad y envío a mi ciudad?
            {%- endcapture -%}
            <a class="boton boton--secundario boton--ancho" href="https://wa.me/{{ numero_whatsapp }}?text={{ mensaje_wa | strip | url_encode }}" target="_blank" rel="noopener">
              Comprar por WhatsApp
            </a>
            {% render 'aviso-datos-whatsapp' %}
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <p>Tu carrito está vacío.</p>
      <a class="boton" href="{{ routes.all_products_collection_url }}">Ver la colección</a>
    {%- endif -%}
    </div>
  </div>
</section>
</carrito-combos>

{% schema %}
{
  "name": "Carrito",
  "settings": []
}
{% endschema %}
