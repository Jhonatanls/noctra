{{ 'componente-combos.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Combos destacados en el inicio (SPEC-005, RF-32). Vitrina de marketing: nombre, qué incluye,
  precio y descripción salen de Ajustes del tema > Combos, así coinciden con los mensajes del carrito.
  El precio real lo pone Shopify con los descuentos automáticos del admin.
{%- endcomment -%}
<section class="seccion combos">
  <div class="contenedor">
    <div class="combos__cabecera">
      {% render 'logo', variante: 'isotipo', clase: 'combos__isotipo', decorativo: true %}
      <h2 class="combos__titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}
        <p class="combos__intro">{{ section.settings.texto }}</p>
      {%- endif -%}
    </div>

    <ul class="combos__lista">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = 'combo_' | append: block.settings.combo | append: '_'
          assign k_activo = p | append: 'activo'
          assign k_nombre = p | append: 'nombre'
          assign k_detalle = p | append: 'detalle'
          assign k_precio = p | append: 'precio'
          assign k_descripcion = p | append: 'descripcion'
          assign i = block.settings.combo | plus: 0
        -%}
        {%- capture total_combo -%}{%- render 'combos-precio', i: i, dato: 'total' -%}{%- endcapture -%}
        {%- capture ahorro_combo -%}{%- render 'combos-precio', i: i, dato: 'ahorro' -%}{%- endcapture -%}
        {%- capture lista_combo -%}{%- render 'combos-precio', i: i, dato: 'lista' -%}{%- endcapture -%}
        {%- assign total_combo = total_combo | strip | plus: 0 -%}
        {%- assign ahorro_combo = ahorro_combo | strip | plus: 0 -%}
        {%- assign lista_combo = lista_combo | strip | plus: 0 -%}
        {%- assign precio_texto = total_combo | money_without_trailing_zeros | strip_html -%}
        {%- assign ahorro_texto = ahorro_combo | money_without_trailing_zeros | strip_html -%}
        {%- if settings[k_precio] != blank -%}{%- assign precio_texto = settings[k_precio] -%}{%- endif -%}
        {%- assign descripcion = settings[k_descripcion] | replace: '{precio}', precio_texto | replace: '{ahorro}', ahorro_texto -%}
        {%- if settings[k_activo] or request.design_mode -%}
          <li class="combo{% if block.settings.favorito %} combo--favorito{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.favorito -%}
              <p class="combo__sello">{{ 'combos.favorito' | t }}</p>
            {%- endif -%}
            {% render 'ornamento', clase: 'combo__ornamento' %}
            <h3 class="combo__nombre">{{ settings[k_nombre] }}</h3>
            <p class="combo__detalle">{{ settings[k_detalle] }}</p>
            <p class="combo__precio precio">{{ precio_texto }}</p>
            {%- if ahorro_combo > 0 and settings[k_precio] == blank -%}
              <p class="combo__comparacion">
                <s class="combo__anterior"><span class="oculto-visual">Precio sin combo: </span>{{ lista_combo | money_without_trailing_zeros | strip_html }}</s>
                <span class="combo__ahorro">Ahorras {{ ahorro_texto }}</span>
              </p>
            {%- endif -%}
            <p class="combo__descripcion">{{ descripcion }}</p>
            {%- if block.settings.nota != blank -%}
              <p class="combo__nota">{{ block.settings.nota }}</p>
            {%- elsif request.design_mode -%}
              <p class="aviso-editor">Falta la vigencia y las condiciones de este combo. Es obligatorio antes de publicar.</p>
            {%- endif -%}
            {%- if block.settings.enlace != blank -%}
              <a class="boton boton--secundario combo__boton" href="{{ block.settings.enlace }}">Ver productos del combo</a>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.cierre != blank -%}
      <p class="combos__cierre">{{ section.settings.cierre }}</p>
    {%- endif -%}

    {%- if section.settings.terminos != blank -%}
      <p class="nota-legal combos__terminos">
        <a href="{{ section.settings.terminos.url }}">Consulta los términos y condiciones de los combos</a>
      </p>
    {%- elsif request.design_mode -%}
      <p class="aviso-editor combos__terminos">Falta la página de términos de los combos. Es obligatoria antes de publicar.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Combos destacados",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Combos" },
    { "type": "text", "id": "texto", "label": "Texto", "default": "Combos de precio fijo. El descuento se aplica solo en el carrito." },
    { "type": "text", "id": "cierre", "label": "Cierre", "default": "Viste la noche." },
    { "type": "page", "id": "terminos", "label": "Página de términos de los combos", "info": "Obligatoria antes de publicar: vigencia, productos elegibles, límites y si se acumulan con otros descuentos." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "select",
          "id": "combo",
          "label": "Combo a mostrar",
          "options": [
            { "value": "1", "label": "Combo 1" },
            { "value": "2", "label": "Combo 2" },
            { "value": "3", "label": "Combo 3" }
          ],
          "default": "1",
          "info": "Nombre, precio y descripción se editan en Ajustes del tema > Combos."
        },
        { "type": "checkbox", "id": "favorito", "label": "Destacar como favorito", "default": false, "info": "Muestra el sello \"El favorito\" sobre la tarjeta. Úsalo en un solo combo." },
        { "type": "text", "id": "nota", "label": "Vigencia y condiciones", "info": "Obligatorio antes de publicar. Ejemplo: Válido hasta el 31 de diciembre de 2026 o hasta agotar existencias. Solo productos de las colecciones en combo." },
        { "type": "url", "id": "enlace", "label": "Enlace", "info": "Colección con los productos elegibles." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Combos destacados",
      "blocks": [
        { "type": "combo", "settings": { "combo": "1" } },
        { "type": "combo", "settings": { "combo": "2", "favorito": true } },
        { "type": "combo", "settings": { "combo": "3" } }
      ]
    }
  ]
}
{% endschema %}
