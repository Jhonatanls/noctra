{{ 'componente-ficha.css' | asset_url | stylesheet_tag }}
{{ 'componente-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'componente-combos.js' | asset_url }}" type="module"></script>

{%- liquid
  assign variante = product.selected_or_first_available_variant
  assign id_formulario = 'formulario-producto-' | append: section.id
  assign numero_whatsapp = settings.whatsapp_numero | remove: '+' | remove: ' ' | remove: '-'
  assign url_producto = shop.url | append: product.url

  # Gama alta (Noctra Premium): lleva su sello y no lleva sello ni bloque de combo
  assign gama = product.metafields.custom.gama.value
  assign es_gama_alta = false
  if settings.gama_premium_valor != blank and gama == settings.gama_premium_valor
    assign es_gama_alta = true
  endif
  capture grupo_combo
    render 'combos-grupo', producto: product
  endcapture
  assign grupo_combo = grupo_combo | strip

  # Opción de talla EUR: se llama Talla (o Size / Tallas), tiene más de un valor y algún valor es numérico.
  # Una opción de un solo valor nunca se pinta como selector.
  assign tiene_talla_eur = false
  for opcion in product.options_with_values
    assign nombre_opcion = opcion.name | downcase
    if nombre_opcion == 'talla' or nombre_opcion == 'size' or nombre_opcion == 'tallas'
      if opcion.values.size > 1
        for valor in opcion.values
          assign nombre_valor = valor.name | default: valor
          assign numero_valor = nombre_valor | plus: 0
          if numero_valor > 0
            assign tiene_talla_eur = true
          endif
        endfor
      endif
    endif
  endfor

  # Detalle de la variante para el mensaje de WhatsApp: talla primero, luego las demás opciones con más de un valor
  assign detalle_wa = ''
  if product.variants.size > 1
    for opcion in product.options_with_values
      assign nombre_opcion = opcion.name | downcase
      if opcion.values.size > 1
        if nombre_opcion == 'talla' or nombre_opcion == 'size' or nombre_opcion == 'tallas'
          assign detalle_wa = detalle_wa | append: variante.options[forloop.index0] | append: ' / '
        endif
      endif
    endfor
    for opcion in product.options_with_values
      assign nombre_opcion = opcion.name | downcase
      if opcion.values.size > 1
        unless nombre_opcion == 'talla' or nombre_opcion == 'size' or nombre_opcion == 'tallas'
          assign detalle_wa = detalle_wa | append: variante.options[forloop.index0] | append: ' / '
        endunless
      endif
    endfor
    assign detalle_wa = detalle_wa | remove_last: ' / '
  endif

  assign en_cuotas = false
  assign total_medios = product.media.size

  # Galería por color (SPEC-004): el grupo de un color empieza en la foto asignada a sus variantes
  # (posición en Multimedia) y llega hasta antes del grupo siguiente. Lo anterior al primer grupo es común.
  assign indice_color = -1
  assign valores_color = ''
  for opcion in product.options_with_values
    assign nombre_opcion = opcion.name | downcase
    if nombre_opcion == 'color' or nombre_opcion == 'colour' or nombre_opcion == 'colores'
      if opcion.values.size > 1
        assign indice_color = forloop.index0
        assign valores_color = opcion.values
      endif
    endif
  endfor

  assign inicios = ''
  if indice_color >= 0
    for valor in valores_color
      assign nombre_color = valor.name | default: valor
      assign minimo = 0
      for v in product.variants
        if v.options[indice_color] == nombre_color and v.featured_media != blank
          for m in product.media
            if m.id == v.featured_media.id
              if minimo == 0 or forloop.index < minimo
                assign minimo = forloop.index
              endif
            endif
          endfor
        endif
      endfor
      if minimo > 0
        assign posicion_txt = '0000' | append: minimo | slice: -4, 4
        assign inicios = inicios | append: posicion_txt | append: '~' | append: nombre_color | append: '|'
      endif
    endfor
  endif

  # Dos colores con la misma foto asignada es un error de carga: esos colores muestran todos los medios
  assign lista_inicios = inicios | split: '|'
  assign grupos_validos = ''
  for entrada in lista_inicios
    assign posicion_a = entrada | split: '~' | first
    assign repetidos = 0
    for otra in lista_inicios
      assign posicion_b = otra | split: '~' | first
      if posicion_a == posicion_b
        assign repetidos = repetidos | plus: 1
      endif
    endfor
    if repetidos == 1
      assign grupos_validos = grupos_validos | append: entrada | append: '|'
    endif
  endfor
  assign lista_grupos = grupos_validos | split: '|' | sort

  assign color_inicial = ''
  if indice_color >= 0
    assign color_inicial = variante.options[indice_color]
  endif
  assign galeria_por_color = false
  assign primer_visible = 1
  for entrada in lista_grupos
    assign partes = entrada | split: '~'
    if partes[1] == color_inicial
      assign galeria_por_color = true
      assign primer_visible = partes[0] | plus: 0
    endif
  endfor
-%}

<ficha-producto
  class="ficha contenedor seccion"
  data-seccion="{{ section.id }}"
  data-url="{{ url_producto }}"
  data-producto="{{ product.title | escape }}"
  data-whatsapp="{{ numero_whatsapp }}"
  data-color-inicial="{{ color_inicial | escape }}"
>
  <div class="ficha__galeria" role="group" aria-roledescription="carrusel" aria-label="Fotos de {{ product.title | escape }}">
    <ul class="ficha__medios" data-medios>
      {%- for medio in product.media -%}
        {%- liquid
          assign grupo_medio = ''
          for entrada in lista_grupos
            assign partes = entrada | split: '~'
            assign inicio_grupo = partes[0] | plus: 0
            if inicio_grupo <= forloop.parentloop.index
              assign grupo_medio = partes[1]
            endif
          endfor
          assign fuera = false
          if galeria_por_color and grupo_medio != '' and grupo_medio != color_inicial
            assign fuera = true
          endif
        -%}
        <li class="ficha__medio marco"
          {%- if lista_grupos.size > 0 %}{% if grupo_medio == '' %} data-comun{% else %} data-grupo="{{ grupo_medio | escape }}"{% endif %}{% endif -%}
          {%- if fuera %} data-fuera{% endif -%}
          {%- if medio.media_type == 'image' %} data-zoom-src="{{ medio | image_url: width: 2048 }}" data-zoom-alt="{{ medio.alt | default: product.title | escape }}"{% endif %}>
          {%- case medio.media_type -%}
            {%- when 'image' -%}
              {%- assign alt_medio = medio.alt | default: product.title -%}
              {%- if forloop.index == primer_visible -%}
                {{ medio | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 58vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: alt_medio }}
              {%- else -%}
                {{ medio | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 58vw, 100vw', loading: 'lazy', alt: alt_medio }}
              {%- endif -%}
            {%- when 'video' -%}
              {{ medio | video_tag: controls: true, muted: true, playsinline: true, preload: 'none', image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ medio | external_video_tag }}
            {%- else -%}
              {{ medio | media_tag }}
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="ficha__medio">{{ 'product-1' | placeholder_svg_tag: 'ficha__placeholder' }}</li>
      {%- endfor -%}
    </ul>
    {%- if total_medios > 1 -%}
      <p class="ficha__contador" data-contador role="status" hidden>1 de {{ total_medios }}</p>
    {%- endif -%}
    {%- if lista_grupos.size > 0 -%}
      <p class="oculto-visual" role="status" aria-live="polite" data-anuncio-galeria></p>
    {%- endif -%}
  </div>

  <div class="ficha__info">
    {%- for block in section.blocks -%}
      {%- if block.type != '@app' and block.type != 'cuotas' -%}
        {%- assign en_cuotas = false -%}
      {%- endif -%}
      {%- case block.type -%}
        {%- when 'titulo' -%}
          <div class="ficha__cabecera" {{ block.shopify_attributes }}>
            {%- if es_gama_alta -%}
              <p class="ficha__sellos"><span class="sello sello--premium">{{ gama }}</span></p>
            {%- elsif grupo_combo != blank -%}
              <p class="ficha__sellos"><span class="sello sello--combo">{{ 'combos.sello_ficha' | t }}</span></p>
            {%- endif -%}
            <h1 class="ficha__titulo">{{ product.title }}</h1>
          </div>
          {% render 'ornamento' %}

        {%- when 'precio' -%}
          <p class="ficha__precio" {{ block.shopify_attributes }}>
            <span class="precio" data-precio>{{ variante.price | money }}</span>
            <s class="precio__anterior" data-precio-anterior{% unless variante.compare_at_price > variante.price %} hidden{% endunless %}>
              <span class="oculto-visual">Antes </span><span data-precio-anterior-valor>{{ variante.compare_at_price | money }}</span>
            </s>
          </p>
          {%- if cart.taxes_included -%}
            <p class="nota-legal">IVA incluido.</p>
          {%- endif -%}

        {%- when 'cuotas' -%}
          {%- assign en_cuotas = true -%}
          <div class="ficha__cuotas-ancla" {{ block.shopify_attributes }}></div>

        {%- when 'selector' -%}
          <div class="ficha__selector" id="selector-{{ section.id }}" {{ block.shopify_attributes }}>
            {%- unless product.has_only_default_variant -%}
              <div class="ficha__opciones" data-opciones hidden>
                {%- for opcion in product.options_with_values -%}
                  {%- liquid
                    assign nombre_opcion = opcion.name | downcase
                    assign es_talla = false
                    if nombre_opcion == 'talla' or nombre_opcion == 'size' or nombre_opcion == 'tallas'
                      assign es_talla = true
                    endif
                    assign es_talla_eur = false
                    if es_talla and tiene_talla_eur
                      assign es_talla_eur = true
                    endif
                    assign es_unica = false
                    if opcion.values.size < 2
                      assign es_unica = true
                    endif
                    assign indice_opcion = forloop.index0
                  -%}
                  <fieldset
                    class="ficha__opcion"
                    data-indice-opcion="{{ indice_opcion }}"
                    data-agotado="{% if es_talla %}agotada{% else %}agotado{% endif %}"
                    {% if es_talla %}data-talla{% endif %}
                    {% if indice_opcion == indice_color %}data-opcion-color{% endif %}
                    {% if es_unica %}data-unica hidden{% endif %}
                  >
                    <legend class="ficha__leyenda">
                      {{ opcion.name }}{% if es_talla_eur %} (EUR){% endif %}:
                      <span data-valor-elegido>{{ opcion.selected_value }}</span>
                    </legend>
                    <div class="ficha__valores{% if es_talla_eur %} ficha__valores--talla{% endif %}">
                      {%- for valor in opcion.values -%}
                        {%- assign nombre_valor = valor.name | default: valor -%}
                        {%- assign id_valor = section.id | append: '-' | append: indice_opcion | append: '-' | append: forloop.index0 -%}
                        <input
                          class="ficha__radio oculto-visual"
                          type="radio"
                          id="{{ id_valor }}"
                          name="opcion-{{ section.id }}-{{ indice_opcion }}"
                          value="{{ nombre_valor | escape }}"
                          {% if opcion.selected_value == nombre_valor %}checked{% endif %}
                        >
                        <label class="ficha__valor" for="{{ id_valor }}">
                          <span>{{ nombre_valor }}</span>
                          {%- if es_talla_eur -%}<span class="ficha__cm" data-cm-para="{{ nombre_valor | escape }}"></span>{%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            {%- if tiene_talla_eur -%}
              <p class="ficha__equivalencia" data-equivalencia aria-live="polite"></p>
              {% render 'guia-tallas', solo_datos: true %}

              {%- if block.settings.mostrar_guia -%}
                {%- liquid
                  assign pagina_guia = block.settings.pagina_guia
                  if pagina_guia == blank
                    assign pagina_guia = pages['guia-de-tallas']
                  endif
                -%}
                {%- if pagina_guia != blank -%}
                  <a href="{{ pagina_guia.url }}" class="enlace-boton ficha__abrir-guia" data-abrir-dialogo="guia-{{ section.id }}">¿Cuál es mi talla?</a>
                {%- else -%}
                  <button type="button" class="enlace-boton ficha__abrir-guia" data-abrir-dialogo="guia-{{ section.id }}" data-requiere-js hidden>¿Cuál es mi talla?</button>
                {%- endif -%}
                <dialog class="dialogo" id="guia-{{ section.id }}" aria-labelledby="titulo-guia-{{ section.id }}">
                  <button type="button" class="enlace-boton dialogo__cerrar" data-cerrar-dialogo>
                    <span class="oculto-visual">Cerrar</span>{% render 'icono', nombre: 'cerrar' %}
                  </button>
                  <h2 id="titulo-guia-{{ section.id }}">Guía de tallas</h2>
                  {% render 'guia-tallas', id_prefijo: section.id, sin_datos: true %}
                </dialog>
              {%- endif -%}
            {%- endif -%}
          </div>

        {%- when 'botones' -%}
          <div class="ficha__compra" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: id_formulario, class: 'ficha__formulario' -%}
              <label class="ficha__select-variantes" data-select-variantes>
                <span>Elige una opción</span>
                <select name="id">
                  {%- for v in product.variants -%}
                    <option value="{{ v.id }}"{% if v.id == variante.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                      {{ v.title }}{% unless v.available %} (agotado){% endunless %} &ndash; {{ v.price | money }}
                    </option>
                  {%- endfor -%}
                </select>
              </label>
              <button type="submit" class="boton boton--ancho" data-boton-agregar{% unless variante.available %} disabled{% endunless %}>
                {%- if variante.available -%}Agregar al carrito{%- else -%}Agotado{%- endif -%}
              </button>
            {%- endform -%}

            {%- if numero_whatsapp != blank -%}
              {%- capture mensaje_wa -%}
                {%- if variante.available -%}Hola, quiero pedir {% else %}Hola, avísenme cuando llegue {% endif -%}
                {{ product.title }}{% if detalle_wa != blank %} ({{ detalle_wa }}){% endif %}: {{ url_producto }}?variant={{ variante.id }}
              {%- endcapture -%}
              <a
                class="boton boton--secundario boton--ancho"
                href="https://wa.me/{{ numero_whatsapp }}?text={{ mensaje_wa | url_encode }}"
                target="_blank"
                rel="noopener"
                data-boton-whatsapp
              >
                {%- if variante.available -%}Pedir por WhatsApp{%- else -%}Preguntar disponibilidad por WhatsApp{%- endif -%}
              </a>
              {% render 'aviso-datos-whatsapp' %}
            {%- endif -%}
          </div>

        {%- when 'combo' -%}
          <div class="ficha__combo" {{ block.shopify_attributes }}>{% render 'combos-ficha', producto: product, premium: es_gama_alta, grupo: grupo_combo %}</div>

        {%- when 'descripcion' -%}
          <div class="ficha__descripcion" {{ block.shopify_attributes }}>{{ product.description }}</div>

        {%- when 'politicas' -%}
          {%- if shop.shipping_policy != blank or shop.refund_policy != blank -%}
            <details class="ficha__desplegable" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.titulo }}</summary>
              <div class="ficha__desplegable-contenido">
                <p>{{ block.settings.texto }}</p>
                <ul class="ficha__politicas">
                  {%- if shop.shipping_policy != blank -%}
                    <li><a href="{{ shop.shipping_policy.url }}">Política de envíos</a></li>
                  {%- endif -%}
                  {%- if shop.refund_policy != blank -%}
                    <li><a href="{{ shop.refund_policy.url }}">Política de cambios y devoluciones</a></li>
                  {%- endif -%}
                </ul>
              </div>
            </details>
          {%- endif -%}

        {%- when 'desplegable' -%}
          <details class="ficha__desplegable" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.titulo }}</summary>
            <div class="ficha__desplegable-contenido">{{ block.settings.contenido }}</div>
          </details>

        {%- when 'texto' -%}
          <div class="ficha__texto" {{ block.shopify_attributes }}>{{ block.settings.texto }}</div>

        {%- when '@app' -%}
          {%- if en_cuotas -%}
            {%- if settings.mostrar_cuotas -%}
              <div class="ficha__app ficha__app--cuotas">{% render block %}</div>
              {%- assign siguiente = section.blocks[forloop.index] -%}
              {%- unless siguiente.type == '@app' -%}
                <p class="nota-legal ficha__cuotas-nota">Sujeto a aprobación.</p>
              {%- endunless -%}
            {%- endif -%}
          {%- else -%}
            <div class="ficha__app">{% render block %}</div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if product.media.size > 0 -%}
    <dialog class="dialogo ficha__zoom" id="zoom-{{ section.id }}" aria-label="Foto ampliada" data-zoom-dialogo>
      <button type="button" class="enlace-boton dialogo__cerrar ficha__zoom-cerrar" data-cerrar-dialogo>
        <span class="oculto-visual">Cerrar</span>{% render 'icono', nombre: 'cerrar' %}
      </button>
      <img class="ficha__zoom-imagen" alt="" width="2048" height="2560" data-zoom-imagen>
    </dialog>
  {%- endif -%}

  {%- if section.settings.barra_fija -%}
    <div class="ficha__barra" role="group" aria-label="Compra rápida" data-barra hidden>
      <div class="ficha__barra-datos">
        <p class="ficha__barra-nombre">{{ product.title }}</p>
        <p class="ficha__barra-detalle">
          <span data-barra-seleccion></span>
          <span class="precio" data-barra-precio>{{ variante.price | money }}</span>
        </p>
      </div>
      <button type="submit" form="{{ id_formulario }}" class="boton" data-barra-boton>Agregar al carrito</button>
    </div>
  {%- endif -%}

  <script type="application/json" data-variantes>{{ product.variants | json }}</script>
</ficha-producto>

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Ficha de producto",
  "settings": [
    {
      "type": "checkbox",
      "id": "barra_fija",
      "label": "Mostrar barra fija de compra en celular",
      "default": true,
      "info": "Aparece abajo cuando el botón de compra sale de la pantalla."
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "titulo", "name": "Nombre", "limit": 1 },
    { "type": "precio", "name": "Precio", "limit": 1 },
    {
      "type": "cuotas",
      "name": "Mensaje de cuotas",
      "limit": 1
    },
    {
      "type": "selector",
      "name": "Opciones y tallas",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "mostrar_guia", "label": "Mostrar guía de tallas", "default": true },
        {
          "type": "page",
          "id": "pagina_guia",
          "label": "Página de guía de tallas",
          "info": "A donde lleva «¿Cuál es mi talla?» si el navegador no usa JavaScript. Si la dejas vacía se usa la página con dirección guia-de-tallas."
        }
      ]
    },
    { "type": "botones", "name": "Botones de compra", "limit": 1 },
    { "type": "combo", "name": "Mensaje de combo", "limit": 1 },
    { "type": "descripcion", "name": "Descripción", "limit": 1 },
    {
      "type": "politicas",
      "name": "Envíos y cambios",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Envíos y cambios" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Consulta nuestras condiciones de envío y de cambios." }
      ]
    },
    {
      "type": "desplegable",
      "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Más información" },
        { "type": "richtext", "id": "contenido", "label": "Contenido" }
      ]
    },
    {
      "type": "texto",
      "name": "Texto",
      "settings": [
        { "type": "richtext", "id": "texto", "label": "Texto" }
      ]
    }
  ]
}
{% endschema %}
