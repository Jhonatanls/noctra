<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-modo-base="{{ settings.modo_predeterminado | default: 'oscuro' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark light">
    <meta name="theme-color" content="#0E0F11">
    <script>
      {%- comment -%} Aplica el modo guardado antes de pintar para evitar parpadeo (SPEC-001) y marca que hay JavaScript (SPEC-004: galería por color). {%- endcomment -%}
      document.documentElement.setAttribute('data-js', '');
      (function () {
        try {
          var t = localStorage.getItem('tema');
          if (t === 'claro' || t === 'oscuro') document.documentElement.setAttribute('data-tema', t);
        } catch (e) {}
      })();
    </script>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {% render 'meta-sociales' %}

    {% render 'fuentes' %}

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="plantilla-{{ template.name }}">
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    {% sections 'header-group' %}

    <main id="contenido" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'whatsapp-flotante' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
