{
  "name": "noctra-tienda",
  "private": true,
  "type": "module",
  "description": "Tema de Shopify y lógica de combos de la tienda de Noctra",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/combos/test/*.test.js",
    "sync:combos": "node scripts/sync-combos.mjs",
    "theme:dev": "shopify theme dev --path theme",
    "theme:check": "shopify theme check --path theme"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.85",
    "@shopify/dev-mcp": "1.18.0"
  }
}
