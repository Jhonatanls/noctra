{
  "name": "noctra-tienda",
  "private": true,
  "type": "module",
  "description": "Tema de Shopify y lógica de combos de la tienda de Noctra",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test packages/combos/test/*.test.js",
